# -----------------------------------------------------------------------------
# BWiGA Adriatic — env vars for the ticket payment flow.
# Copy to .env.local (git-ignored) for local dev, or set in Vercel dashboard
# for prod. If a var is missing, the app falls back to mock/console mode so
# nothing crashes — see lib/custodex.ts (isCustodexConfigured) and
# lib/emails.ts (client()) for the exact fallback rules.
# -----------------------------------------------------------------------------

# --- Custodex crypto payment gateway ---
# From LC (Настройки → Интеграция → Public / Secret keys).
# merchant_uuid is NOT required (single-merchant accounts). Leave commented
# unless Custodex support tells you otherwise.
CUSTODEX_API_PUBLIC=
CUSTODEX_API_SECRET=
# CUSTODEX_MERCHANT_UUID=

# Base URL. Prod only — Custodex has no sandbox. For live tests, keep this
# but drop TICKET_PRICE to 1 USD in TRX to spend near-zero.
CUSTODEX_BASE_URL=https://my.custodex.sv

# Default cryptocurrency shown on the Custodex hosted payment page. Users can
# switch to any supported token from that page (strict_currency: false is set
# in code). For live tests use TRX (Tron, low fees).
CUSTODEX_DEFAULT_TOKEN=USDTTRC

# --- Ticket pricing ---
# EUR is supported by Custodex (undocumented in swagger but confirmed by
# support). For test invoices drop this to 1 (USD).
TICKET_PRICE=200
TICKET_CURRENCY=EUR

# --- Gmail SMTP transactional email (nodemailer) ---
# Uses a dedicated Gmail account (e.g. BWiGA2026@gmail.com) as the sender.
# SMTP_PASSWORD is a Gmail App Password — generate at
# myaccount.google.com/apppasswords (requires 2FA on that Google account).
# NOT the regular Gmail login password. Spaces in the shown value are
# stripped automatically by lib/emails.ts, but easier to save without them.
# Without SMTP_USER/PASSWORD all email sends become console logs so the
# flow still works in dev without secrets.
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=BWiGA Tickets <BWiGA2026@gmail.com>
NOTIFY_EMAILS=mail@lead-volume.com,maxkysh@gmail.com

# Absolute site URL used in email links + Custodex redirect / callback URLs.
SITE_URL=https://www.adriaticawards.com
